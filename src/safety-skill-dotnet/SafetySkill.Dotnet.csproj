<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);MCPEXP001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Lightweight AIFunction/AIFunctionFactory abstractions, used only to derive SKILL.md "script" metadata
         from the same [Description]-annotated methods that are registered as MCP tools below. No chat client
         or agent hosting is needed: this project is a standalone MCP skill-provider server, not a hosted agent. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.0" />
    <!-- MCP server hosting: exposes the safety skill (SEP-2640 discovery + tool "scripts") for the Python
         skills-based orchestrator. This is additive: the existing safety-agent-python A2A agent is untouched. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\service-defaults\service-defaults.csproj" />
  </ItemGroup>
</Project>
