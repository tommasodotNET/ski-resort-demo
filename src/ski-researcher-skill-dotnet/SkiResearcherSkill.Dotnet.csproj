<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MCPEXP001;OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to match the transitively-resolved version elsewhere in the dependency graph (e.g.
         ski-advisor-a2a): Azure.AI.Extensions.OpenAI's ProjectResponsesClient must be extended by the
         SAME Microsoft.Extensions.AI.OpenAI build that AsIChatClient resolves against, or the compiler treats
         the OpenAI.Responses.ResponsesClient base type as a different type identity (CS1061). -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
    <PackageReference Include="Azure.AI.Projects" Version="2.1.0-beta.4" />
    <PackageReference Include="Azure.AI.Projects.Agents" Version="2.1.0-beta.4" />
    <PackageReference Include="Azure.AI.Extensions.OpenAI" Version="2.1.0-beta.4" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.13.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\service-defaults\service-defaults.csproj" />
  </ItemGroup>

</Project>
